# Homebrew Bundle — `salesforce` module
#
# Salesforce / Apex development tooling. Installed only on machines whose
# `modules` list (chezmoi config) includes `salesforce`.
#
#   brew bundle --file=Brewfile.salesforce

# ---------------------------------------------------------------------------
# VS Code extensions
# ---------------------------------------------------------------------------
# Non-Salesforce Apex / Log utilities
vscode "financialforce.lana"
vscode "peterweinberg.apexdox-vs-code"

# Primary Salesforce Extension Pack (Includes Apex, LWC, SOQL, Org Browser, Core, etc.)
vscode "salesforce.salesforcedx-vscode-expanded"

# Agentforce & Additional Standalone Tooling
vscode "salesforce.agent-script-language-client"
vscode "salesforce.agentforce-vibes-autocomplete"
vscode "salesforce.salesforce-vscode-slds"
vscode "salesforce.salesforcedx-einstein-gpt"
vscode "salesforce.salesforcedx-metadata-visualizer-vscode"
vscode "salesforce.sfdx-code-analyzer-vscode"
